import {readFileSync,writeFileSync,mkdirSync,cpSync} from 'node:fs';
import {join,resolve} from 'node:path';
import {execFileSync} from 'node:child_process';
import {parse,type DefaultTreeAdapterMap} from 'parse5';
import {navigationMap} from '../src/navigation-paths.mts';
import {applyServiceIntent,intentRoutes} from '../src/service-intent-candidate.mts';
import {buildKnowledgeFeeds} from '../src/chinese-feed.mts';
import {isThirdPartyDestination} from '../src/customer-links.mts';
import {validateSite} from '../admin/validate.mts';
const out=resolve('.local-admin/service-intent-preview'),report=resolve('../reports/melbourne-comparison-2026-10-21');
execFileSync(process.execPath,['build.mjs'],{stdio:'inherit',env:{...process.env,SERVICE_INTENT_SKIP_RELEASE:'1'}});mkdirSync(out,{recursive:true});cpSync('dist',out,{recursive:true});
cpSync('content/service-intent-candidate.css',join(out,'assets/service-intent-candidate.css'));
const baseline=new Map(navigationMap.map(row=>[row.url,readFileSync(join('dist',row.url.slice(1),'index.html'),'utf8')]));
const draft=new Map([...baseline].map(([route,html])=>[route,applyServiceIntent(route,html)]));
const en=buildKnowledgeFeeds(draft,{name:'Ellis Services Group'}),zh=buildKnowledgeFeeds(en.pages,{name:'Ellis Services Group',prefix:'/zh',language:'zh-Hans'});
const block=/<script id="llm-knowledge-feed" type="application\/json">[\s\S]*?<\/script>/;
const changed:string[]=[];
for(const[route,html]of draft){const feed=zh.pages.get(route)?.match(block)?.[0],final=feed?html.replace(block,()=>feed):html,before=baseline.get(route)!;
 if(final!==before)changed.push(route);
 if(!intentRoutes.includes(route)&&final!==before)throw Error('Unexpected non-target change '+route);
 for(const pattern of [/<h1\b[^>]*>[\s\S]*?<\/h1>/g,/<link\b[^>]*rel="(?:canonical|alternate)"[^>]*>/g,/<img\b[^>]*>/g])if(JSON.stringify(before.match(pattern))!==JSON.stringify(final.match(pattern)))throw Error('Protected page content changed '+route);
 function visit(n:DefaultTreeAdapterMap['node']){if('tagName'in n&&n.tagName==='a'&&isThirdPartyDestination(n.attrs.find(a=>a.name==='href')?.value||''))throw Error('Third-party outbound link '+route);if('childNodes'in n)n.childNodes.forEach(visit);}visit(parse(final));
 draft.set(route,final);writeFileSync(join(out,route.slice(1),'index.html'),final.replace('<html ','<html data-navigation-preview '));
}
if(changed.length!==6)throw Error('Expected six changed HTML pages, got '+changed.length);
validateSite(out,draft);
for(const[prefix,feed]of [['',en.feed],['zh/',zh.feed]]as const)writeFileSync(join(out,prefix,'feeds/llm-knowledge.json'),JSON.stringify(feed,null,2)+'\n');
writeFileSync(join(out,'robots.txt'),'User-agent: *\nDisallow: /\n');
mkdirSync(report,{recursive:true});writeFileSync(join(report,'candidate-validation.json'),JSON.stringify({checkedAt:new Date().toISOString(),publicPages:draft.size,changedHtml:changed,unchangedHtml:draft.size-changed.length,protected:['H1','canonical','hreflang','images','contact API'],newRoutes:0,thirdPartyLinks:0,status:'local only; not deployed',preview:'http://127.0.0.1:8785/zh/services/timber-window-repairs/'},null,2)+'\n');
console.log(JSON.stringify({publicPages:draft.size,changedHtml:changed,preview:out,errors:0},null,2));
